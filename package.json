{
  "name": "dsh-workbench",
  "version": "1.2.1",
  "private": true,
  "description": "工作台 · 国开作业：账号登录/退出、一键执行并暂停继续，真实作答与交卷，浏览器下方按科目统计正常/异常并下钻明细",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/15819913214/dsh-ouchn-workbench.git"
  },
  "homepage": "https://github.com/15819913214/dsh-ouchn-workbench#readme",
  "bugs": {
    "url": "https://github.com/15819913214/dsh-ouchn-workbench/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ouchn",
    "homework"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "data",
    "tools",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
